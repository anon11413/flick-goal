<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen for Android 7 - 11 (the theme's window background): sky colour + the round game icon,
     centred and never stretched. Android 12+ uses windowSplashScreen* in values/styles.xml instead. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/flick_sky" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_icon" />
    </item>
</layer-list>
